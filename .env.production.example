# Production environment variables for docker-compose.production.yml
# Copy to .env.production and adjust values.

# Prebuilt image pushed to Docker Hub
WHISPERX_IMAGE=docker.io/taftiz/whisper-offline-image:separated-model

# Tune per-container concurrency
MAX_CONCURRENT_TRANSCRIPTIONS=2

# Keep alignment enabled only when wav2vec2 model is downloaded
ENABLE_ALIGNMENT=1
